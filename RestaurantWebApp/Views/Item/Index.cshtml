@model RestaurantWebApp.Models.ItemViewModel
@{
    ViewData["Title"] = "Add Item";
}

<style>
    #header, #footer {
        display: none;
    }
</style>

<article id="main">
    <section class="wrapper style5" style="padding-top:3em">
        <div class="inner" style="width:70%">
            <a asp-controller="Owner" asp-action="Index" class="btn btn-link">Back</a>
            <table class="table-wrapper-item" style="font-size:medium; color:darkslategrey">
                <tbody>
                    <tr>
                        <td rowspan="4" style="width:30%; text-align:center; vertical-align:middle; border-left:solid 1px rgba(0, 0, 0, 0.125)">
                            Item Image
                            <img src="/images/no-image-icon-23485.png" id="customImgTag" width="300px" />
                            <input asp-for="ImagePath" type="file" class="form-control" />
                        </td>
                        <td style="width:35%">
                            Item Name
                            <input asp-for="ItemName" class="form-control" autocomplete="off" />
                        </td>
                        <td style="width:30%">
                            Item Price
                            <input asp-for="ItemPrice" class="form-control" autocomplete="off" />
                        </td>
                        <td style="width:5%; vertical-align:bottom; border-right:solid 1px rgba(0, 0, 0, 0.125)">
                            USD
                        </td>
                    </tr>
                    <tr style="background-color: rgba(0, 0, 0, 0.0375)">
                        <td style="width:35%">
                            Item Code
                            <input asp-for="ItemCode" class="form-control" autocomplete="off" />
                        </td>
                        <td colspan="2" style="width:35%; border-right:solid 1px rgba(0, 0, 0, 0.125)">
                            Category
                            @Html.DropDownListFor(model => model.CategoryId, new SelectList(Model.CategorySelectListItem, "Value", "Text"), new { @class = "form-control" })
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3" style="border-right:solid 1px rgba(0, 0, 0, 0.125)">
                            Description
                            <textarea asp-for="Description" class="form-control" style="height:200px"></textarea>
                        </td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" style="text-align:right">
                            <input type="button" value="Save" name="save" class="button primary" id="btnSave" />
                            <input type="button" value="Reset" name="reset" class="button primary" id="btnReset" />
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </section>
</article>

@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            $("#btnReset").click(function () {
                ResetItem();
            });

            $("#btnSave").click(function () {
                SaveItem();
            });

            $("#ImagePath").change(function () {
                readURL(this);
            });
        });

        function readURL(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#customImgTag').attr('src', e.target.result);
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function ResetItem() {
            $("#CategoryId").val("1");
            $("#ItemCode").val("");
            $("#ItemName").val("");
            $("#Description").val("");
            $("#ItemPrice").val("");
            $("#ImagePath").val("");
            $("#customImgTag").attr('src', '/images/no-image-icon-23485.png');
        }

        function SaveItem() {
            var formData = new FormData();
            formData.append('categoryId', $('#CategoryId').val());
            formData.append('itemCode', $('#ItemCode').val());
            formData.append('itemName', $('#ItemName').val());
            formData.append('description', $('#Description').val());
            formData.append('itemPrice', $('#ItemPrice').val());

            var fileInput = document.getElementById('ImagePath');
            if (fileInput && fileInput.files && fileInput.files[0]) {
                formData.append('imagePath', fileInput.files[0]);
            }

            $.ajax({
                async: true,
                dataType: 'json',
                type: 'POST',
                contentType: false,
                processData: false,
                url: '/Item/Index',
                data: formData,
                success: function (data) {
                    if (data.success) {
                        alert(data.message);
                        ResetItem();
                    } else {
                        alert(data.message || 'There is some problem to add Item.');
                    }
                },
                error: function () {
                    alert('There is some problem to add Item.');
                }
            });
        }
    </script>
}
