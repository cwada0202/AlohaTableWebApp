@model WebAppECartCore.Models.AccountViewModel
@{
    ViewData["Title"] = "Login";
}

<style>
    .field-validation-error {
        color: red !important;
    }
</style>

<article id="main">
    <section class="wrapper style4" style="padding-top:10em; padding-bottom:10em">
        <div class="login-inner">
            <form asp-action="Authorization" asp-controller="Account" method="post">
                <table class="table-wrapper-login">
                    <tbody>
                        <tr style="background-color: whitesmoke">
                            <td style="width:40%; text-align:center">
                                <label asp-for="UserName" style="margin:0 0 0 0"></label>
                            </td>
                            <td>
                                <input asp-for="UserName" />
                                <span asp-validation-for="UserName" class="field-validation-error"></span>
                            </td>
                        </tr>
                        <tr style="background-color:whitesmoke">
                            <td style="width:40%; text-align:center">
                                <label asp-for="UserPassword" style="margin:0 0 0 0"></label>
                            </td>
                            <td>
                                <input asp-for="UserPassword" type="password" />
                                <span asp-validation-for="UserPassword" class="field-validation-error"></span>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2" style="background-color:whitesmoke">
                                <label class="field-validation-error">@Html.DisplayFor(model => model.LoginErrorMessage)</label>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="2" style="text-align:right">
                                <input type="submit" value="Login" class="btn btn-primary" id="btnLogin" />
                                <input type="reset" value="Clear" class="btn btn-default" id="btnClear" style="background-color:pink" />
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </form>
        </div>
    </section>
</article>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
