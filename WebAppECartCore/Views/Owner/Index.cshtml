@{
    ViewData["Title"] = "Owner";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Owner Page</h2>
        <a asp-controller="Account" asp-action="LogOut" class="btn btn-primary">Log Out</a>
    </div>

    <div class="mt-4 d-flex gap-2 flex-wrap">
        <a asp-controller="Item" asp-action="Index" class="btn btn-success">Add Item</a>
        <a asp-controller="Item" asp-action="ItemList" class="btn btn-secondary">Item List</a>
        <button class="btn btn-secondary" type="button">Delete Item</button>
        <button class="btn btn-secondary" type="button">Edit Item</button>
        <a asp-controller="Order" asp-action="Index" class="btn btn-secondary">Order Record</a>
    </div>
</div>
