@model IEnumerable<WebAppECartCore.Models.ItemListModel>
@{
    ViewData["Title"] = "Item List";
}

<h2>Item List</h2>

<div class="mb-3">
    <a asp-controller="Owner" asp-action="Index" class="btn btn-link">Back</a>
</div>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Item code</th>
            <th>Image</th>
            <th>ID</th>
            <th>Name</th>
            <th>Price</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ItemCode</td>
                <td><img src="@item.ImagePath" style="width:100px; height:100px" /></td>
                <td>@item.ItemId</td>
                <td>@item.ItemName</td>
                <td>@item.ItemPrice</td>
                <td>@item.Description</td>
            </tr>
        }
    </tbody>
</table>

<p>
    <a asp-controller="Item" asp-action="Index" class="btn btn-primary">Create New</a>
</p>

<table class="table table-striped table-bordered mt-4">
    <thead>
        <tr>
            <th><a asp-controller="Item" asp-action="ItemList" asp-route-sortOrder="@ViewBag.CateSortParm">Category</a></th>
            <th>Item Code</th>
            <th>Image</th>
            <th>Item ID</th>
            <th><a asp-controller="Item" asp-action="ItemList" asp-route-sortOrder="@ViewBag.NameSortParm">Item Name</a></th>
            <th>Item Price</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ItemCategory</td>
                <td>@item.ItemCode</td>
                <td><img src="@item.ImagePath" style="width:100px; height:100px" /></td>
                <td>@item.ItemId</td>
                <td>@item.ItemName</td>
                <td>@item.ItemPrice</td>
                <td>@item.Description</td>
                <td>
                    <a asp-controller="Item" asp-action="Edit" asp-route-id="@item.ItemId" class="btn btn-sm btn-warning">Edit</a>
                    <form asp-controller="Item" asp-action="Delete" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.ItemId" />
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this item?');">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
