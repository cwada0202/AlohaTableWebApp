@model WebAppECartCore.Models.ItemViewModel
@{
    ViewData["Title"] = "Edit Item";
}

<h2>Edit Item</h2>

<form asp-action="Edit" asp-controller="Item" method="post" enctype="multipart/form-data">
    <input asp-for="ItemId" type="hidden" />
    <div class="mb-3">
        <img src="@Model.CurrentImagePath" alt="Current item" style="width:180px; height:180px; object-fit:cover;" />
    </div>
    <div class="mb-3">
        <label asp-for="ImagePath" class="form-label">Image</label>
        <input asp-for="ImagePath" type="file" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="ItemName" class="form-label">Item Name</label>
        <input asp-for="ItemName" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="ItemCode" class="form-label">Item Code</label>
        <input asp-for="ItemCode" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="ItemPrice" class="form-label">Item Price</label>
        <input asp-for="ItemPrice" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label">Category</label>
        @Html.DropDownListFor(model => model.CategoryId, new SelectList(Model.CategorySelectListItem, "Value", "Text"), new { @class = "form-control" })
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label">Description</label>
        <textarea asp-for="Description" class="form-control" rows="5"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-controller="Item" asp-action="ItemList" class="btn btn-secondary">Cancel</a>
</form>
