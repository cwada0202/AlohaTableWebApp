@model IEnumerable<WebAppECartCore.Models.ShoppingViewModel>
@{
    ViewData["Title"] = "Order";
}

@section Scripts {
    <script>
        const myModal = new bootstrap.Modal(document.getElementById('myModal'));

        $(document).ready(function () {
            $("input[type=number]").on("change", function () {
                calculateBalance();
            });

            $("#btnAddToCart").on("click", function () {
                var item = $("#btnAddToCart").data("item");
                AddToCart(item);
            });
        });

        function DisplaySelectedItem(item) {
            var itemName = $(item).attr("itemname");
            var unitPrice = $(item).attr("itemprice");
            var quantity = $("#txtQuantity").val();
            var total = Number(unitPrice) * Number(quantity);

            $("#txtItemName").val(itemName);
            $("#txtUnitPrice").val(Number(unitPrice).toFixed(2));
            $("#txtTotal").val(Number(total).toFixed(2));
            $("#btnAddToCart").data("item", item);
            myModal.show();
        }

        function AddToCart(item) {
            var itemId = $(item).attr("itemid");
            var itemQuantity = $("#txtQuantity").val();

            var formData = new FormData();
            formData.append("ItemId", itemId);
            formData.append("Qty", itemQuantity);

            $.ajax({
                async: true,
                type: 'POST',
                contentType: false,
                processData: false,
                data: formData,
                url: '/Shopping/Index',
                success: function (data) {
                    if (data.success) {
                        myModal.hide();
                        $("#txtQuantity").val("1");
                        location.reload();
                    }
                },
                error: function () {
                    alert("There is some problem.");
                }
            });
        }

        function calculateBalance() {
            var quantity = $("#txtQuantity").val();
            var unitPrice = $("#txtUnitPrice").val();
            var total = Number(unitPrice) * Number(quantity);
            $("#txtTotal").val(Number(total).toFixed(2));
        }
    </script>
}

<div class="container my-4">
