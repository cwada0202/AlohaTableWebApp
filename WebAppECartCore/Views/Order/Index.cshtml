@model IEnumerable<WebAppECartCore.Models.OrderRecordModel>
@{
    ViewData["Title"] = "Order Record";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Order Record</h2>
        <a asp-controller="Owner" asp-action="Index" class="btn btn-primary">Back</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <table class="table table-striped table-bordered mb-0">
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Order Number</th>
                        <th>Order Date</th>
                        <th>Items</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>@order.OrderId</td>
                            <td>@order.OrderNumber</td>
                            <td>@order.OrderDate</td>
                            <td>@order.ItemCount</td>
                            <td>@order.Total.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
