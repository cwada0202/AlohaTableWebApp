@model IEnumerable<WebAppECartCore.Models.OrderRecordModel>
@{
    ViewData["Title"] = "Order Record";
}

<h2>Order Record</h2>

<div class="mb-3">
    <a asp-controller="Owner" asp-action="Index" class="btn btn-link">Back</a>
</div>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Order ID</th>
            <th>Order Number</th>
            <th>Order Date</th>
            <th>Items</th>
            <th>Total</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.OrderId</td>
                <td>@order.OrderNumber</td>
                <td>@order.OrderDate</td>
                <td>@order.ItemCount</td>
                <td>@order.Total.ToString("C")</td>
            </tr>
        }
    </tbody>
</table>
