@{
    ViewData["Title"] = "Aloha Table";
}

<div class="home-shell">
    <section class="hero-section">
        <div class="hero-content">
            <h1>Aloha Table</h1>
            <p>
                Welcome to my dummy website.<br />
                I created this website for broadening my experiences and<br />
                deepening my knowledge in development.
            </p>
            <a class="btn btn-primary btn-lg" asp-controller="Shopping" asp-action="Index">Order Online</a>
        </div>
    </section>

    <section class="menu-grid">
        <article class="menu-card">
            <img src="~/images/acaibowl.jpg" alt="Lunch" />
            <div class="card-content">
                <h2>Lunch</h2>
                <p>Try hawaiian breakfast for your lunch!</p>
            </div>
        </article>

        <article class="menu-card">
            <img src="~/images/ribeyesteak.jpg" alt="Dinner" />
            <div class="card-content">
                <h2>Dinner</h2>
                <p>Dinner will be served with 2 sides of your choice.</p>
            </div>
        </article>

        <article class="menu-card">
            <img src="~/images/kidsmeal.jpg" alt="Kids Meal" />
            <div class="card-content">
                <h2>Kids Meal</h2>
                <p>Kids meal will be served with 1 side of your choice and one drink and one dessert.</p>
            </div>
        </article>

        <article class="menu-card">
            <img src="~/images/GarlcShrimp01.jpg" alt="Pupus" />
            <div class="card-content">
                <h2>Pupus</h2>
                <p>“Pupu” is a Hawaiian term for any appetizer, snack or finger food.</p>
            </div>
        </article>

        <article class="menu-card">
            <img src="~/images/dessert.jpg" alt="Dessert" />
            <div class="card-content">
                <h2>Dessert</h2>
                <p>Try our homemade coconut cake!</p>
            </div>
        </article>

        <article class="menu-card">
            <img src="~/images/coffee.jpg" alt="Beverage" />
            <div class="card-content">
                <h2>Beverage</h2>
                <p>Want some Hawaiian coffee?</p>
            </div>
        </article>
    </section>
</div>
