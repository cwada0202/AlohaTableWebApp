{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AlohaTableWebApp (ASP.NET Core)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/WebAppECartCore/bin/Debug/net10.0/WebAppECartCore.dll",
      "cwd": "${workspaceFolder}/WebAppECartCore",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on: (https?://\\S+)",
        "uriFormat": "%s"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:5010"
      }
    }
  ]
}